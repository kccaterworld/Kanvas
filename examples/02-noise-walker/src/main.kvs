/**
 * Noise Walker - Phase 1 Feature Showcase
 * 
 * Demonstrates:
 * - noise() for creating organic, smooth motion
 * - map() for converting noise values to screen coordinates
 * - Random colors and trail effects
 * - Trig functions: radians()
 */

import java.util.ArrayList;

ArrayList<int[]> trail;
int maxTrail = 100;

void setup() {
    size(800, 600);
    smooth();
    trail = new ArrayList<int[]>();
}

void draw() {
    // Use noise to create smooth x, y motion
    double t = frameCount * 0.01;
    double x = map(noise(t, 0), 0, 1, 50, width - 50);
    double y = map(noise(0, t), 0, 1, 50, height - 50);
    
    // Add to trail (store as int pair)
    trail.add(new int[]{(int)x, (int)y});
    if (trail.size() > maxTrail) {
        trail.remove(0);
    }
    
    // Fade background
    fill(250, 250, 250);
    noStroke();
    rect(0, 0, width, height);
    
    // Draw trail with fading circles
    noStroke();
    for (int i = 0; i < trail.size(); i++) {
        fill(100, 180, 255);
        double size = map(i, 0, trail.size(), 5, 15);
        int[] pos = trail.get(i);
        circle((float)pos[0], (float)pos[1], (float)size);
    }
    
    // Draw main circle
    fill(255, 100, 100);
    stroke(100, 50, 50);
    strokeWeight(2);
    circle((float)x, (float)y, 30);
    
    // Example using distance calculation
    double distToMouse = dist(x, y, mouseX, mouseY);
    if (distToMouse < 100) {
        fill(255, 150, 100);
        noStroke();
        circle(mouseX, mouseY, 50);
    }
}

/**
 * Particle System
 * - random() and randomSeed() for reproducible randomness
 * - dist() for distance calculations between particles
 * - lerpColor() for color transitions
 * - Classes defined within the sketch
 */

import java.util.ArrayList;

ArrayList<Particle> particles;
float gravity = 0.1f;

void setup() {
    size(800, 600);
    smooth();
    particles = new ArrayList<>();
    randomSeed(42); // For reproducibility
}

void draw() {
    background(30);

    // Update and display particles, removing dead ones
    for (int i = particles.size() - 1; i >= 0; i--) {
        Particle p = particles.get(i);
        p.update();
        p.display();
        if (p.isDead()) particles.remove(i);
    }

    // Emit new particles from mouse
    for (int i = 0; i < 3; i++) {
        particles.add(new Particle(mouseX, mouseY));
    }

    // Draw connections between nearby particles
    stroke(255, 100, 100);
    strokeWeight(1);
    for (int i = 0; i < particles.size(); i++) {
        for (int j = i + 1; j < particles.size(); j++) {
            Particle a = particles.get(i);
            Particle b = particles.get(j);
            if (dist(a.x, a.y, b.x, b.y) < 50) line(a.x, a.y, b.x, b.y);
        }
    }

    println("Particles: " + particles.size() + " | FPS: " + (int) frameRate);
}

class Particle {
    float x, y, vx, vy;
    float life = 255;

    Particle(double x, double y) {
        this.x = (float) x;
        this.y = (float) y;
        vx = (float) random(-2, 2);
        vy = (float) random(-5, -2);
    }

    void update() {
        x += vx;
        y += vy;
        vy += gravity;
        life -= 1;
    }

    void display() {
        float lifePercent = life / 255;
        // Lerp between colors based on life
        fill(lerpColor(color(100, 50, 50), color(255, 200, 100), lifePercent));
        noStroke();
        circle(x, y, 10 * lifePercent);
    }

    boolean isDead() {
        return life <= 0;
    }
}
